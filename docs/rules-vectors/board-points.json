      "given": {
        "board": { "line": ["2-3"], "spinner": null, "top": [], "bottom": [] },
        "tile": "3-3",
        "end": "right"
      },
      "expect": {
        "legal": true,
        "board": { "line": ["2-3", "3-3"], "spinner": null, "top": [], "bottom": [] },
        "openEnds": { "left": 2, "right": 6 },
        "total": 8,
        "score": 0
      }
    },
