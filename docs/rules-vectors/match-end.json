      "given": { "end": "domino", "scores": { "A": 240, "B": 370 } },
      "expect": { "outcome": "won", "winner": "B" }
    },
    {
      "id": "match-example9-higher-wins",
      "kind": "match-end",
      "rules": ["R-46"],
