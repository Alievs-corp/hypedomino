{
  "$schema": "./schema.json",
  "vectors": [
    {
      "id": "match-domino-one-team-over",
      "kind": "match-end",
      "rules": ["R-43", "R-46"],
      "description": "A domino ends the hand with A at 370 and B at 200; A wins the match",
      "mode": "2v2",
      "given": { "end": "domino", "scores": { "A": 370, "B": 200 } },
      "expect": { "outcome": "won", "winner": "A" }
    },
    {
      "id": "match-exactly-365",
      "kind": "match-end",
      "rules": ["R-43", "R-46"],
      "description": "A domino ends the hand with A at exactly 365 and B at 100; A wins the match",
      "mode": "2v2",
      "given": { "end": "domino", "scores": { "A": 365, "B": 100 } },
      "expect": { "outcome": "won", "winner": "A" }
    },
    {
      "id": "match-364-not-reached",
      "kind": "match-end",
      "rules": ["R-43", "R-48"],
      "description": "A domino ends the hand with A at 364 and B at 200; nobody has 365, a new hand is dealt",
      "mode": "2v2",
      "given": { "end": "domino", "scores": { "A": 364, "B": 200 } },
      "expect": { "outcome": "next-hand", "winner": null }
    },
    {
      "id": "match-example8-block-does-not-end",
      "kind": "match-end",
