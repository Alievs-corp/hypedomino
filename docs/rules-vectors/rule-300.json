{
  "$schema": "./schema.json",
  "vectors": [
    {
      "id": "rule300-example5-domino",
      "kind": "hand-end",
      "rules": ["R-41", "R-42"],
      "description": "Example 5: A starts with 310 and reaches 325 with board points; North dominoes over B's 23 pips, but A gets no hand points and keeps 325",
      "mode": "2v2",
      "given": {
        "end": "domino",
        "lastPlacedBy": "N",
        "hands": { "N": [], "E": ["5-6", "4-6"], "S": ["0-1"], "W": ["0-2"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 310, "B": 200 },
        "scores": { "A": 325, "B": 200 },
        "carryOver": 0
      },
      "expect": {
        "pips": { "A": 1, "B": 23 },
        "winner": "A",
        "awarded": { "A": 0, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 325, "B": 200 },
        "nextOpeningTeam": "A"
      }
    },
    {
      "id": "rule300-exactly-300-locks",
      "kind": "hand-end",
      "rules": ["R-41"],
      "description": "B starts the hand with exactly 300 and dominoes; A's 11 pips would give 15, but B gets nothing",
      "mode": "2v2",
      "given": {
        "end": "domino",
        "lastPlacedBy": "E",
        "hands": { "N": ["3-4"], "E": [], "S": ["2-2"], "W": ["1-1"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 150, "B": 300 },
        "scores": { "A": 150, "B": 300 },
        "carryOver": 0
      },
      "expect": {
        "pips": { "A": 11, "B": 2 },
        "winner": "B",
        "awarded": { "A": 0, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 150, "B": 300 },
        "nextOpeningTeam": "B"
      }
    },
    {
      "id": "rule300-299-still-scores",
      "kind": "hand-end",
      "rules": ["R-41"],
      "description": "B starts the hand with 299 and dominoes; A's 11 pips round to 15 and B goes to 314",
      "mode": "2v2",
      "given": {
        "end": "domino",
        "lastPlacedBy": "E",
        "hands": { "N": ["3-4"], "E": [], "S": ["2-2"], "W": ["1-1"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 150, "B": 299 },
        "scores": { "A": 150, "B": 299 },
        "carryOver": 0
      },
      "expect": {
        "pips": { "A": 11, "B": 2 },
        "winner": "B",
        "awarded": { "A": 0, "B": 15 },
        "carryOver": 0,
        "scores": { "A": 150, "B": 314 },
        "nextOpeningTeam": "B"
      }
    },
    {
      "id": "rule300-block-winner-locked",
      "kind": "hand-end",
      "rules": ["R-37", "R-41"],
      "description": "Block: B has the lower total (4 against 21) but started the hand with 320, so B gets no hand points",
      "mode": "2v2",
      "given": {
        "end": "block",
        "lastPlacedBy": "W",
        "hands": { "N": ["6-6"], "E": ["0-1"], "S": ["4-5"], "W": ["0-3"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 280, "B": 320 },
        "scores": { "A": 280, "B": 320 },
        "carryOver": 0
      },
      "expect": {
        "pips": { "A": 21, "B": 4 },
        "winner": "B",
        "awarded": { "A": 0, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 280, "B": 320 },
        "nextOpeningTeam": "B"
      }
    },
    {
      "id": "rule300-example7-carry-over-discarded",
      "kind": "hand-end",
      "rules": ["R-39", "R-41"],
      "description": "Example 7: B started hand 6 with 300 and dominoes; B gets neither the 15 nor the 35 carry-over, which is discarded",
      "mode": "2v2",
      "given": {
        "end": "domino",
        "lastPlacedBy": "E",
        "hands": { "N": ["3-4"], "E": [], "S": ["1-4"], "W": ["2-6"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 120, "B": 300 },
        "scores": { "A": 120, "B": 300 },
        "carryOver": 35
      },
      "expect": {
        "pips": { "A": 12, "B": 8 },
        "winner": "B",
        "awarded": { "A": 0, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 120, "B": 300 },
        "nextOpeningTeam": "B"
      }
    },
    {
      "id": "rule300-block-carry-over-discarded",
      "kind": "hand-end",
      "rules": ["R-39", "R-41", "R-42"],
      "description": "Block with carry-over 20: A wins (3 against 20) but started with 330; A keeps its 10 board points (340) and the carry-over is discarded",
      "mode": "2v2",
      "given": {
        "end": "block",
        "lastPlacedBy": "N",
        "hands": { "N": ["0-0"], "E": ["5-5"], "S": ["1-2"], "W": ["4-6"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 330, "B": 250 },
        "scores": { "A": 340, "B": 250 },
        "carryOver": 20
      },
      "expect": {
        "pips": { "A": 3, "B": 20 },
        "winner": "A",
        "awarded": { "A": 0, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 340, "B": 250 },
        "nextOpeningTeam": "A"
      }
    },
    {
      "id": "rule300-only-winner-matters",
      "kind": "hand-end",
      "rules": ["R-41"],
      "description": "B has 340 but A (200) dominoes; A scores B's 18 pips rounded to 20",
      "mode": "2v2",
      "given": {
        "end": "domino",
        "lastPlacedBy": "S",
        "hands": { "N": ["0-5"], "E": ["6-6"], "S": [], "W": ["3-3"] },
        "boneyard": [],
        "scoresAtHandStart": { "A": 200, "B": 340 },
        "scores": { "A": 200, "B": 340 },
        "carryOver": 0
      },
      "expect": {
        "pips": { "A": 5, "B": 18 },
        "winner": "A",
        "awarded": { "A": 20, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 220, "B": 340 },
        "nextOpeningTeam": "A"
      }
    },
    {
      "id": "rule300-1v1-domino-locked",
      "kind": "hand-end",
      "rules": ["R-8", "R-41"],
      "description": "1v1: X started the hand with 305 and dominoes; Y's 9 pips would give 10, but X gets nothing",
      "mode": "1v1",
      "given": {
        "end": "domino",
        "lastPlacedBy": "X",
        "hands": { "X": [], "Y": ["4-5"] },
        "boneyard": ["0-0"],
        "scoresAtHandStart": { "A": 305, "B": 100 },
        "scores": { "A": 305, "B": 100 },
        "carryOver": 0
      },
      "expect": {
        "pips": { "A": 0, "B": 9 },
        "winner": "A",
        "awarded": { "A": 0, "B": 0 },
        "carryOver": 0,
        "scores": { "A": 305, "B": 100 },
        "nextOpeningTeam": "A"
      }
    },
    {
      "id": "rule300-board-points-at-310",
      "kind": "place",
      "rules": ["R-25", "R-42"],
      "description": "The placing team started the hand with 310; 2-4 still scores 10 board points",
      "mode": "2v2",
      "given": {
        "board": { "line": ["2-3", "3-3"], "spinner": null, "top": [], "bottom": [] },
        "tile": "2-4",
        "end": "left",
        "teamScoreAtHandStart": 310
      },
      "expect": {
        "legal": true,
        "board": { "line": ["4-2", "2-3", "3-3"], "spinner": null, "top": [], "bottom": [] },
        "openEnds": { "left": 4, "right": 6 },
        "total": 10,
        "score": 10
      }
    },
    {
      "id": "rule300-board-points-at-300",
      "kind": "place",
      "rules": ["R-42"],
      "description": "The placing team started the hand with exactly 300; 3-5 on the spinner arm still scores 10",
      "mode": "2v2",
      "given": {
        "board": { "line": ["4-2", "2-3", "3-3", "3-1"], "spinner": "3-3", "top": [], "bottom": [] },
        "tile": "3-5",
        "end": "top",
        "teamScoreAtHandStart": 300
      },
      "expect": {
        "legal": true,
        "board": {
          "line": ["4-2", "2-3", "3-3", "3-1"],
          "spinner": "3-3",
          "top": ["3-5"],
          "bottom": []
        },
        "openEnds": { "left": 4, "right": 1, "top": 5 },
        "total": 10,
        "score": 10
      }
    },
    {
      "id": "rule300-example8-board-points-at-370",
      "kind": "place",
      "rules": ["R-17", "R-42"],
      "description": "Example 8: B started the next hand with 370 and cannot take hand points, but 1-3 still scores 5 board points",
      "mode": "2v2",
      "given": {
        "board": { "line": ["4-2", "2-3", "3-3"], "spinner": null, "top": [], "bottom": [] },
        "tile": "1-3",
        "end": "right",
        "teamScoreAtHandStart": 370
      },
      "expect": {
        "legal": true,
        "board": { "line": ["4-2", "2-3", "3-3", "3-1"], "spinner": "3-3", "top": [], "bottom": [] },
        "openEnds": { "left": 4, "right": 1 },
        "total": 5,
        "score": 5
      }
    },
    {
      "id": "rule300-board-points-1v1",
      "kind": "place",
      "rules": ["R-42"],
      "description": "1v1: the placing player started the hand with 340; 2-5 still scores 5 board points",
      "mode": "1v1",
      "given": {
        "board": { "line": ["3-5"], "spinner": null, "top": [], "bottom": [] },
